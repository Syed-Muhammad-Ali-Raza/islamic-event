# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/community_events?schema=public"

# ─── Docker Compose (postgres service) ───────────────────────────────────────
# Used by docker-compose.yml to create the DB container and derive DATABASE_URL
# inside the compose network. Set POSTGRES_PORT to avoid clashes with an
# existing local PostgreSQL (e.g. 55432).
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="community_events"
POSTGRES_PORT=5432
# Host ports for the compose services
API_PORT=4000
WEB_PORT=3000

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Seeded admin (used by `npm run db:seed`) ───────────────────────────────
# Email of the ADMIN account created by the seed (default: admin@communityevents.pk).
ADMIN_EMAIL="admin@communityevents.pk"
# Password of the seeded admin. REQUIRED in production (min 12 chars) —
# the seed refuses to create the admin without it when NODE_ENV=production.
# Leave empty in development and the seed generates a strong random password
# and prints it to the console ONCE.
ADMIN_PASSWORD=""

# ─── API ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
API_PREFIX="/api/v1"

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# (Legacy single-origin CORS_ORIGIN is still accepted if this is unset.)
CORS_ORIGINS="http://localhost:3000"

# ─── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Community Events"
